# Slack (obrigatório para o bot)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Idebras — fotos, parecer e perícias (obrigatório para /fotos, /parecer e /pericias)
LOGIN_USER=seu_usuario
LOGIN_PASS=sua_senha
BASE_URL=url_do_servidor

# CP Infobase — fluxos (obrigatório para /fluxos-cp)
CP_USER=seu_usuario_cp
CP_PASS=sua_senha_cp
# CP_EXE=C:\Program Files (x86)\Advocacia Valera\CP MCMV\infobase.exe

# Envio automático diário de fluxos CP (canal/user ID + horário HH:MM)
FLUXOS_CP_CANAL=C0123456789
FLUXOS_CP_HORARIO=23:58

# Envio automático diário de perícias finalizadas (como /pericias hoje)
PERICIAS_CANAL=C0123456789
PERICIAS_HORARIO=17:45

# Pasta de rede dos PDFs da Revisão do Parecer (Idebras)
# REVISAO_PARECER_DIR=B:\ADILSON_ENGENHARIA\12. Revisão do Parecer

# Destinos do download horário de Words (08:00–17:00)
# REVISAO_CANAL=U060LFFTHPF

# Opcional
# SLACKBOT_TEMP_DIR=./tmp/slack

# Usuários que podem usar o comando /revisao
REVISAO_USUARIOS=U06QT81F88P,U060LFFTHPF

# 2FA
2FA_url=https://api.aqui

# EPROC - TRF2
EPROC_USER=usuario
EPROC_PASS=senha
EPROC_BASE_URL=https://eproc.jfrj.jus.br/eproc/
EPROC_2FA_ADVOGADO=NOME COMPLETO
EPROC_2FA_TRIBUNAL=TRF 2
# EPROC_TRIBUNAL também é aceito no lugar de EPROC_2FA_TRIBUNAL
